{
  "project": "syphon-unicamex",
  "goal": "Use installed UniCamEx as virtual-camera backend for Webcam Motion Capture via Syphon",
  "targets": [
    "SyphonUniCamExBridge"
  ],
  "phases": {
    "phase0": "test pattern -> UniCamEx -> QuickTime/Chrome/Meet",
    "phase1": "Syphon -> UniCamEx -> Chrome/Meet",
    "phase2": "zero-copy / minimum-copy optimization"
  },
  "policies": {
    "no_obs": true,
    "no_custom_camera_extension_first": true,
    "no_dal_first": true,
    "queue_policy": "newest-frame-wins",
    "default_output": {
      "width": 1280,
      "height": 720,
      "fps": 30
    }
  },
  "preferred_frame_path": [
    "Syphon MTLTexture",
    "UniCamEx adapter",
    "UniCamEx virtual camera"
  ],
  "fallback_frame_source": "animated test pattern"
}